{
  "name": "@juvantage/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Juvantage OS Mac desktop — Solo agent + Desktop",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node ./scripts/ensure-electron.cjs",
    "dev:ui": "vite --port 5173 --strictPort --host 127.0.0.1",
    "dev": "concurrently -k -n vite,electron -c teal,magenta \"npm run dev:ui\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@juvantage/shared": "*",
    "lottie-react": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.5.8",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  }
}
