# Copy to apps/api/.env

# SQLite for local (default). For Postgres: postgresql://user:pass@localhost:5432/juvantage
DATABASE_URL="file:./dev.db"

# Optional — Plan & usage (Stripe Checkout for Brain Pro)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BRAIN_PRO=
OS_BILLING_RETURN_URL="http://localhost:5173/#desktop?settings=plan"

# JWT secret for session tokens
JWT_SECRET="change-me-in-production-use-long-random-string"

# Platform-managed LLM (server only — never ship to iOS)
# Leave empty to use deterministic demo agent responses
ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
LLM_PROVIDER="anthropic"
LLM_MODEL="claude-sonnet-4-20250514"

# Google OAuth (optional — Personal OS demo connect works without)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/oauth/google/callback"
# Personal OS (Phase 2) — add this redirect URI in Google Cloud Console
GOOGLE_OS_REDIRECT_URI="http://localhost:3001/os/oauth/google/callback"

# Encrypt OAuth tokens at rest (defaults to JWT_SECRET if unset)
TOKEN_ENCRYPTION_KEY=""

# Instagram / Meta (optional — demo connector works without)
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3001/oauth/instagram/callback"

# API
PORT=3001
CORS_ORIGIN="*"
DEMO_MODE="true"

# Jira backlog seeding (npm run jira:backlog -- --apply). API token: id.atlassian.com → Security → API tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=JOS

# Optional local override for incident → GitHub dispatch.
# Prefer AWS Secrets Manager secret juvantage/jos/github-dispatch (JSON key GITHUB_DISPATCH_TOKEN).
# GITHUB_DISPATCH_TOKEN=
# GITHUB_REPOSITORY=JuvantageCloud/juvantage-os
# AWS_SECRET_GITHUB_DISPATCH=juvantage/jos/github-dispatch
# AWS_SECRET_JIRA=juvantage/jos/jira
# AWS_REGION=us-east-1
